<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.mossimo.finalprojectsem3final.controller.MainMenuController"
            styleClass="root-pane">

    <center>
        <!-- VBox stacks children vertically -->
        <VBox alignment="CENTER" spacing="10" maxWidth="560">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- Title  -->
            <Label text="StockSim" styleClass="title"/>
            <Label text="Virtual trading in a fictional market"
                   styleClass="subtitle"/>

            <Region prefHeight="28"/>

            <!-- Difficulty  -->
            <VBox spacing="6" maxWidth="360" styleClass="panel">
                <Label text="DIFFICULTY" styleClass="section-label"/>

                <!-- The controller fills this with Difficulty.values() in
                     initialize(). Difficulty.toString() returns the friendly
                     name, which is why the list does not read "EASY NORMAL
                     HARD" in capitals -->
                <ComboBox fx:id="difficultyCombo" maxWidth="Infinity"/>

                <!-- Updated by the controller whenever the selection changes -->
                <Label fx:id="difficultyDescription"
                       text=""
                       styleClass="muted-text"
                       wrapText="true"
                       minHeight="52"/>

                <Label fx:id="difficultyTargets"
                       text=""
                       styleClass="mono, muted-text"/>
            </VBox>
