<?xml version="1.0" encoding="UTF-8"?>

<?import org.mossimo.finalprojectsem3final.ui.StatisticsPanel?>
<?import org.mossimo.finalprojectsem3final.ui.TradePanel?>
<?import org.mossimo.finalprojectsem3final.ui.SummaryBar?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.mossimo.finalprojectsem3final.controller.DashboardController"
            styleClass="root-pane">

    <top>
        <VBox styleClass="app-header">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="STOCKSIM" styleClass="app-brand"/>

                <Label fx:id="difficultyLabel" text="" styleClass="app-state"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="clockLabel" text="Day 1 / 10   09:00" styleClass="app-clock"/>
                <Label fx:id="stateLabel" text="Ready" styleClass="app-state"/>

                <Button fx:id="playPauseButton" text="Play" onAction="#onPlayPause"
                        styleClass="button-primary" prefWidth="86"/>
                <Button fx:id="speedButton" text="1x" onAction="#onSpeed" prefWidth="56"/>
                <Button fx:id="portfolioButton" text="Portfolio" onAction="#onPortfolio"/>
                <Button fx:id="saveButton" text="Save" onAction="#onSave"/>
                <Button fx:id="menuButton" text="Menu" onAction="#onMenu"
                        styleClass="button-ghost"/>
            </HBox>

            <ProgressBar fx:id="progressBar" progress="0.0" maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </ProgressBar>
        </VBox>
    </top>

<!--
        Center
-->
    <center>
        <VBox>
            <padding>
                <Insets top="6" right="18" bottom="18" left="18"/>
            </padding>

            <SummaryBar fx:id="summaryBar"/>

            <SplitPane fx:id="splitPane" dividerPositions="0.47" VBox.vgrow="ALWAYS"
                       styleClass="dashboard-split">

                <!-- LEFT: the market  -->
                <VBox spacing="8">
                    <padding>
                        <Insets top="0" right="10" bottom="0" left="0"/>
                    </padding>

                    <Label text="MARKET" styleClass="section-label"/>

                    <TableView fx:id="marketTable" VBox.vgrow="ALWAYS"/>

                    <Label fx:id="marketIndexLabel" text="" styleClass="muted-text, mono"/>

                </VBox>

                <!-- RIGHT: the selected company -->
                <VBox spacing="8">
                    <padding>
                        <Insets top="0" right="0" bottom="0" left="10"/>
                    </padding>

                    <Label text="SELECTED COMPANY" styleClass="section-label"/>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="detailNameLabel" text="Select a company"
                               styleClass="detail-name"/>
                        <Label fx:id="riskBadge" text="" styleClass="risk-badge"/>
                    </HBox>

                    <Label fx:id="detailIndustryLabel" text="" styleClass="detail-industry"/>

                    <HBox alignment="BASELINE_LEFT" spacing="12">
                        <Label fx:id="detailPriceLabel" text="—" styleClass="detail-price"/>
                        <Label fx:id="detailChangeLabel" text="" styleClass="detail-change"/>
                    </HBox>

                    <Label fx:id="detailDescriptionLabel" text="" wrapText="true"
                           styleClass="detail-description"/>

                    <StackPane fx:id="chartContainer" minHeight="200" VBox.vgrow="ALWAYS"
                               styleClass="chart-panel"/>

                    <StatisticsPanel fx:id="statisticsPanel"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <TradePanel fx:id="tradePanel"/>
                </VBox>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>
